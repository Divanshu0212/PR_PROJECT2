# Backend build context (repo root). Keep the image lean and the build fast.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Frontend is built from its own context (./web) — never ship it into the backend.
web/
node_modules/

# Local secrets, data, docs, evaluation scratch — none belong in the backend image.
.env
.git/
docs/
eval/
tests/
scratchpad/
vendor/
*.csv
report.md
Dockerfile*
docker-compose.yml
